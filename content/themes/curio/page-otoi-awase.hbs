{{!< default}}
{{! The tag above means - insert everything in this file into the {body} of the default.hbs template }}

<div class="content-area-wrap">
	{{> mobile-header}}
	<!-- start main content -->
	<div class="container-fluid main-content-wrap">
		<div class="row">
			{{#post}}
			<div class="single-post-wrap">
				<article id="{{id}}" class="{{post_class}} single-post-full">
          <div class="post-content-full">
            {{content}}
          </div>
          <p>
            <iframe src="https://docs.google.com/forms/d/e/1FAIpQLSdoomLw6yg4cHwU-34C8qvVArggxmhh77WuVTm1dtVtfdrfQg/viewform?embedded=true" width="100%" height="1200" frameborder="0" marginheight="0" marginwidth="0" onload="window.parent.scrollTo(0,0)">Loading…</iframe>
          </p>
				</article>
			</div>
			{{/post}}
		</div>
	</div>
	<!-- end main content -->
</div>
